# Copy to .env.local for local development. Never commit real secrets.
#   cp .env.example .env.local

# Database ---------------------------------------------------------------
# REQUIRED. Postgres connection string. Matches the docker-compose.yml service.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/portfolio

# Auth -------------------------------------------------------------------
# REQUIRED. Payload CMS encryption secret. Generate one: openssl rand -base64 32
# Placeholder below is dev-only, obviously not production.
PAYLOAD_SECRET=dev-only-change-me-openssl-rand-base64-32

# Site -------------------------------------------------------------------
# OPTIONAL. Public site URL used for absolute links/metadata.
# Default: https://zdnemz.vercel.app
NEXT_PUBLIC_SERVER_URL=https://zdnemz.vercel.app

# Storage ----------------------------------------------------------------
# OPTIONAL. S3-compatible object storage for Payload media uploads (AWS S3,
# Cloudflare R2, MinIO). Set S3_BUCKET to activate the adapter; with no S3 vars
# set, uploads stay on local disk exactly as before.

# REQUIRED to activate. Bucket name. This is the activation switch: leave it
# empty and the S3 adapter stays disabled, so local-disk uploads keep working.
S3_BUCKET=
# REQUIRED when S3 is enabled. Bucket region (e.g. us-east-1 for AWS S3, auto for R2).
S3_REGION=
# REQUIRED when S3 is enabled. Access key ID with read/write access to the bucket.
S3_ACCESS_KEY_ID=
# REQUIRED when S3 is enabled. Secret access key for the access key ID above.
S3_SECRET_ACCESS_KEY=
# OPTIONAL. Custom S3-compatible endpoint URL (R2, MinIO); omit for AWS S3.
S3_ENDPOINT=
# OPTIONAL. Set to true to use path-style URLs (needed by MinIO); defaults to false.
S3_FORCE_PATH_STYLE=
# OPTIONAL. Public base URL for serving files (e.g. an R2 custom domain).
S3_PUBLIC_URL=

# GitHub -----------------------------------------------------------------
# OPTIONAL. Raises the GitHub API rate limit for project data fetching.
GITHUB_TOKEN=

# Seeding ----------------------------------------------------------------
# LOCAL DEV ONLY. Never use these credentials in production.
# Initial admin account created by the seed script.
SEED_ADMIN_EMAIL=admin@zdnemz.dev
# LOCAL DEV ONLY. Never use this password in production.
SEED_ADMIN_PASSWORD=portfolio-dev-2026

# Removed integrations ---------------------------------------------------
# NOTION_* variables (NOTION_TOKEN, NOTION_*_DATABASE_ID) are REMOVED from this
# project. Do not re-add them; content comes from Payload CMS.
