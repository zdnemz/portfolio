# Copy to .env.local for local development. Never commit real secrets.
#   cp .env.example .env.local

# Database ---------------------------------------------------------------
# REQUIRED. Postgres connection string. Matches the docker-compose.yml service.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/portfolio

# Auth -------------------------------------------------------------------
# REQUIRED. Payload CMS encryption secret. Generate one: openssl rand -base64 32
# Placeholder below is dev-only, obviously not production.
PAYLOAD_SECRET=dev-only-change-me-openssl-rand-base64-32

# Site -------------------------------------------------------------------
# OPTIONAL. Public site URL used for absolute links/metadata.
# Default: https://zdnemz.vercel.app
NEXT_PUBLIC_SERVER_URL=https://zdnemz.vercel.app

# Storage ----------------------------------------------------------------
# OPTIONAL. Enables the Vercel Blob upload plugin. Leave empty to use local storage.
BLOB_READ_WRITE_TOKEN=

# GitHub -----------------------------------------------------------------
# OPTIONAL. Raises the GitHub API rate limit for project data fetching.
GITHUB_TOKEN=

# Seeding ----------------------------------------------------------------
# LOCAL DEV ONLY. Never use these credentials in production.
# Initial admin account created by the seed script.
SEED_ADMIN_EMAIL=admin@zdnemz.dev
# LOCAL DEV ONLY. Never use this password in production.
SEED_ADMIN_PASSWORD=portfolio-dev-2026

# Removed integrations ---------------------------------------------------
# NOTION_* variables (NOTION_TOKEN, NOTION_*_DATABASE_ID) are REMOVED from this
# project. Do not re-add them; content comes from Payload CMS.
